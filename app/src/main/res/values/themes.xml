<resources>
    <style name="Base.Theme.SkinCheck" parent="Theme.Material3.Light.NoActionBar">
        <!-- Main color (buttons, selected tab) -->
        <item name="colorPrimary">@color/rose</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/rose_light</item>
        <item name="colorOnPrimaryContainer">@color/plum</item>

        <!-- Soft highlight (e.g. the pill behind the selected bottom tab) -->
        <item name="colorSecondaryContainer">@color/rose_light</item>
        <item name="colorOnSecondaryContainer">@color/plum</item>

        <!-- Backgrounds and text -->
        <item name="android:colorBackground">@color/cream</item>
        <item name="colorSurface">@color/cream</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorOutline">@color/line</item>
    </style>

    <style name="Theme.SkinCheck" parent="Base.Theme.SkinCheck" />
</resources>